# Copy to .env (gitignored). Rhapto never sends personal data anywhere except the LLM API.
# AI provider (all optional here — you can instead add a key in the app's Settings page).
# RHAPTO_LLM_PROVIDER picks the env fallback provider (default: anthropic); RHAPTO_LLM_MODEL pairs
# with it (empty = the provider's default), so change both together.
RHAPTO_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# leave empty for the provider's default; pairs with RHAPTO_LLM_PROVIDER
RHAPTO_LLM_MODEL=
RHAPTO_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RHAPTO_SOFFICE_BINARY=soffice

# backend (stage 2)
DATABASE_URL=postgresql+asyncpg://rhapto:rhapto@localhost:5432/rhapto
REDIS_URL=redis://localhost:6379/0
# generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
RHAPTO_API_TOKEN=
# Fernet key used to encrypt provider keys saved in Settings. REQUIRED — the app refuses to start
# without it.
#
# NEW install (nothing encrypted yet): generate a fresh key freely.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# EXISTING install that ever ran with RHAPTO_SECRET_KEY blank: do NOT generate a new key. This
# app used to fall back to a key derived from RHAPTO_API_TOKEN, and everything already saved in
# Settings (provider keys, aggregator credentials) is encrypted under that derived value. You must
# set RHAPTO_SECRET_KEY to that SAME derived value, byte-identical to what the code derived:
#   python -c "import base64,hashlib,os; print(base64.urlsafe_b64encode(hashlib.sha256(os.environ['RHAPTO_API_TOKEN'].encode()).digest()).decode())"
# or, from this repo: scripts/print-derived-secret-key.sh (reads RHAPTO_API_TOKEN from the
# environment; never prints the token itself). See docs/runbook-deploy.md step 5.
#
# ANY OTHER VALUE on an existing install — including a freshly generated key — permanently and
# irreversibly loses every stored provider key and aggregator credential. There is no recovery
# once that happens: the ciphertext cannot be decrypted without the key that produced it.
RHAPTO_SECRET_KEY=
RHAPTO_USER_EMAIL=user@example.com
RHAPTO_PACKAGES_DIR=data/packages
RHAPTO_WEB_ORIGIN=http://localhost:3000

# discovery (phase 0.3)
RHAPTO_POLL_INTERVAL_HOURS=6
RHAPTO_DISCOVERY_USER_AGENT=rhapto-discovery/0.3
# smoke/testing only: rewrites every discovery fetch's scheme and host to this base and skips the
# SSRF public-host check for that hop. Leave empty in every real deployment.
RHAPTO_DISCOVERY_BASE_OVERRIDE=

# frontend (stage 3): the URL the browser uses to reach the API (kept as localhost even
# though containers talk to each other over the compose network). Must match the host
# you open in the browser, and RHAPTO_WEB_ORIGIN above must match the web app's origin.
RHAPTO_PUBLIC_API_URL=http://localhost:8000

# test-only overrides (defaults shown); the test database is created on demand
#RHAPTO_TEST_DATABASE_URL=postgresql+asyncpg://rhapto:rhapto@localhost:5432/rhapto_test
#RHAPTO_TEST_REDIS_URL=redis://localhost:6379/1

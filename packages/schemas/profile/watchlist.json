{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhapto.dev/schemas/profile/watchlist.json",
  "title": "WatchlistFile",
  "type": "object",
  "additionalProperties": false,
  "required": ["watchlist"],
  "properties": {
    "watchlist": { "type": "array", "items": { "$ref": "#/$defs/WatchlistEntry" } },
    "aggregators": { "type": "array", "items": { "$ref": "#/$defs/AggregatorEntry" }, "default": [] }
  },
  "$defs": {
    "WatchlistEntry": {
      "title": "WatchlistEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "source", "board"],
      "properties": {
        "company": { "type": "string" },
        "source": { "type": "string", "enum": ["greenhouse", "lever", "ashby", "workday", "smartrecruiters", "workable"] },
        "board": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" }, "default": [] },
        "discovered": { "type": "boolean", "default": false }
      }
    },
    "AggregatorEntry": {
      "title": "AggregatorEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["remoteok", "hn-hiring", "themuse", "remotive", "adzuna", "jooble", "jsearch"]
        },
        "enabled": { "type": "boolean", "default": true },
        "keywords": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    }
  }
}
